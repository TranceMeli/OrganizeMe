{
  "name": "organizeme-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:production": "playwright test --config playwright.production.config.js",
    "test:e2e:browsers": "playwright test --project=firefox --project=webkit"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@tiptap/core": "3.22.5",
    "@tiptap/extension-text-style": "3.22.5",
    "@tiptap/starter-kit": "3.22.5",
    "@tiptap/vue-3": "3.22.5",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "OrganizeMe Frontend (Vue 3, Vite, Pinia)"
}
